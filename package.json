{
  "name": "btc-quant-terminal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node server/api.js",
    "build": "vite build",
    "preview": "vite preview",
    "build:wasm": "cd src-rust && wasm-pack build --target web --out-dir ../src/lib/wasm",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:status": "docker system df",
    "docker:rebuild": "docker compose build --no-cache && docker compose up -d",
    "docker:clean": "docker image prune -f && docker builder prune -f",
    "docker:clean:deep": "docker image prune -a -f --filter \"until=48h\" && docker builder prune -a -f"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "svelte": "^4.2.7",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "duckdb": "^1.4.4",
    "lightweight-charts": "^4.1.1",
    "pg": "^8.23.0"
  }
}
